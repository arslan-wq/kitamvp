# ============================================================
# KitaLuna – Environment-Variablen (Vorlage)
# Diese Datei NICHT mit echten Werten committen.
# In Vercel unter Settings → Environment Variables eintragen.
# ============================================================

# --- Datenbank (Supabase Postgres) ---
# Für Serverless (Vercel) den Connection-Pooler empfohlen:
#   Supabase → Connect → Connection pooling (Port 6543, ?pgbouncer=true)
DATABASE_URL="postgresql://postgres:PASSWORT@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"

# --- NextAuth ---
# Secret generieren mit: openssl rand -base64 32
NEXTAUTH_SECRET="hier-ein-langes-zufaelliges-secret"
# MUSS die echte Live-Domain sein (https) – sonst schlaegt der Login fehl!
NEXTAUTH_URL="https://app.kitaluna-app.ch"

# --- App ---
NEXT_PUBLIC_APP_NAME="KitaLuna Management"
# Gleiche Live-Domain – steuert u.a. die Onboarding-Links in E-Mails
NEXT_PUBLIC_APP_URL="https://app.kitaluna-app.ch"

# --- E-Mail (Resend) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Absender MUSS eine in Resend verifizierte Domain sein
RESEND_FROM_EMAIL="noreply@kitaluna-app.ch"
NEXT_PUBLIC_RESEND_DOMAIN="kitaluna-app.ch"

# --- Datei-Storage (optional, Supabase Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# --- OAuth (optional, falls Google/Apple-Login genutzt wird) ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
APPLE_CLIENT_ID="com.example.kita-pro"
APPLE_CLIENT_SECRET="your-apple-client-secret"
